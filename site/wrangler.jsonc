{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quick-cli",
  "account_id": "5a8fc5f3ed230a3157b24a394db4f36b",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/docs", "/docs/*", "!/docs/*.md"]
  },
  "workers_dev": true,
  "routes": [{ "pattern": "quick-cli.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
