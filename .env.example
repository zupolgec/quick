# Copia in .env e compila (env della risorsa Coolify). Non committare .env.
# (Il token Cloudflare NON sta qui: vive nell'env del proxy come CF_API_TOKEN,
#  usato dalla label caddy.tls.dns per il certificato wildcard.)

# Dominio dei siti e hosted domain Google ammesso (email).
QUICK_BASE_DOMAIN=quick.example.com
# Domini email Google ammessi all'SSO. Un dominio o una lista "a.com,b.com".
# Per ammettere qualsiasi account scrivi "*" esplicito: se vuoto il server NON
# parte (niente fail-open). Il controllo lo fa quick-server: oauth2-proxy
# ammette ogni account e quick rifiuta quelli fuori da questi domini.
QUICK_ALLOWED_DOMAINS=example.com

# Client OAuth Google della CLI. Due modi:
#  - client "Desktop app" (PKCE, nessun secret): imposta solo QUICK_CLI_CLIENT_ID.
#  - riuso di un client "Web" (anche lo stesso di oauth2-proxy): imposta entrambi;
#    il secret viene servito alla CLI via /api/config.
# Redirect URI autorizzato sul client: http://127.0.0.1:8765/callback
QUICK_CLI_CLIENT_ID=
QUICK_CLI_CLIENT_SECRET=

# Client OAuth Google di oauth2-proxy: tipo "Web application".
# Redirect URI autorizzato: https://<QUICK_BASE_DOMAIN>/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Segreto cookie di oauth2-proxy.            openssl rand -base64 32
COOKIE_SECRET=
# Segreto con cui quick-server firma codici e cookie dei siti privati.
# Su Coolify è auto-generato (magic var nel compose): lascialo vuoto qui.
# Fuori Coolify è OBBLIGATORIO: se vuoto il server non parte.  openssl rand -base64 48
QUICK_META_SECRET=

# Amministratori (email, lista "a@x.com,b@x.com"): possono alzare il limite di
# dimensione dei singoli siti (dashboard o `quick limit`).
QUICK_ADMINS=
# Invio email (facoltativo). Con entrambi impostati, i siti "persone scelte" possono
# includere persone esterne all'azienda, che entrano con un link via email.
# smtp://user:pass@host:587 (STARTTLS) oppure smtps://user:pass@host:465
QUICK_SMTP_URL=
QUICK_MAIL_FROM=
# Limite di dimensione di default per sito, massimo impostabile da un admin,
# spazio da lasciare libero sul disco (solo storage local). Unità: KB, MB, GB.
QUICK_SITE_LIMIT=100MB
QUICK_SITE_LIMIT_MAX=2GB
QUICK_MIN_FREE=5GB

# Storage: local (default) | s3
QUICK_STORAGE=local
# Se QUICK_STORAGE=s3 (object storage S3-compatibile: Hetzner/MinIO/R2/…):
QUICK_S3_ENDPOINT=
QUICK_S3_REGION=
QUICK_S3_BUCKET=
QUICK_S3_ACCESS_KEY=
QUICK_S3_SECRET_KEY=
QUICK_S3_PREFIX=
QUICK_S3_USE_SSL=true
